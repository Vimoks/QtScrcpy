+// 停止并清理所有宏状态（析构/设备断开/切换 keymap/窗口失焦时调用）
+void InputConvertGame::stopAllMacros(bool sendTouchUp) {
+    // 清理所有多点触控宏
+    for (auto it = m_macroMultiTouchStates.begin(); it != m_macroMultiTouchStates.end(); ++it) {
+        MacroMultiTouchState *st = it.value();
+        if (st) {
+            // 防御性钳制：count 赋值处已限制在 MULTI_TOUCH_MAX_NUM 内
+            const int bounded = qMin(st->count, MULTI_TOUCH_MAX_NUM);
+            for (int i = 0; i < bounded; i++) {
+                if (st->touchIds[i] >= 0) {
+                    if (sendTouchUp) {
+                        sendTouchUpEvent(st->touchIds[i], QPointF(0, 0));
+                    }
+                    m_multiTouchID[st->touchIds[i]] = 0;
+                    st->touchIds[i] = -1;
+                }
+            }
+            delete st;
+        }
+    }
+    m_macroMultiTouchStates.clear();
+    // 清理所有循环点击宏
+    for (auto it = m_macroLoopClickStates.begin(); it != m_macroLoopClickStates.end(); ++it) {
+        MacroLoopClickState *st = it.value();
+        if (st) {
+            if (st->timer) {
+                st->timer->stop();
+                delete st->timer;
+            }
+            if (st->touchId >= 0) {
+                if (sendTouchUp) {
+                    sendTouchUpEvent(st->touchId, st->pos);
+                }
+                m_multiTouchID[st->touchId] = 0;
+                st->touchId = -1;
+            }
+            delete st;
+        }
+    }
+    m_macroLoopClickStates.clear();
 }
 
