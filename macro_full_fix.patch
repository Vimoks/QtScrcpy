+// ===== 宏按键扩展（新增校验函数实现）=====
+bool KeyMap::checkForMacroMultiTouch(const QJsonObject &node)
+{
+    if (!checkItemString(node, "key")) {
+        return false;
+    }
+    if (!node.contains("touchNodes") || !node.value("touchNodes").isArray()) {
+        qWarning("json error: macroMultiTouch no find touchNodes array");
+        return false;
+    }
+    QJsonArray touchNodes = node.value("touchNodes").toArray();
+    if (touchNodes.isEmpty()) {
+        qWarning("json error: macroMultiTouch touchNodes is empty");
+        return false;
+    }
+    for (int i = 0; i < touchNodes.size(); i++) {
+        if (!touchNodes.at(i).isObject()) {
+            return false;
+        }
+        QJsonObject tn = touchNodes.at(i).toObject();
+        if (!checkItemPos(tn, "pos") || !checkItemDouble(tn, "delay")) {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool KeyMap::checkForMacroLoopClick(const QJsonObject &node)
+{
+    return checkItemString(node, "key") && checkItemPos(node, "pos");
+}
