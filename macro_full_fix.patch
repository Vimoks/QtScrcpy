+// ===== 宏按键扩展（按 key 独立状态实现，支持多宏并行）=====
+
+// 多点触控宏：按下时按 delay 依次让多个手指落下，抬起时全部抬起
+// 每个触发键有独立的 MacroMultiTouchState，互不影响
+void InputConvertGame::processMacroMultiTouch(const KeyMap::KeyMapNode &node, const QKeyEvent *from)
+{
+    int key = from->key();
+
+    if (QEvent::KeyPress == from->type()) {
+        // 若该 key 上一次的状态还在，先清理（防止连按残留）
+        MacroMultiTouchState *st = m_macroMultiTouchStates.value(key, nullptr);
+        if (st) {
+            const int bounded = qMin(st->count, MULTI_TOUCH_MAX_NUM);
+            for (int i = 0; i < bounded; i++) {
+                if (st->touchIds[i] >= 0) {
+                    sendTouchUpEvent(st->touchIds[i], QPointF(0, 0));
+                    m_multiTouchID[st->touchIds[i]] = 0;
+                    st->touchIds[i] = -1;
+                }
+            }
+            st->count = 0;
+        } else {
+            st = new MacroMultiTouchState();
+            m_macroMultiTouchStates.insert(key, st);
+        }
+        st->pressKey = key;
+        st->generation++;  // 新的一轮按下，作废上一轮未触发的 singleShot 回调
+
+        // 触点数量钳制到 MULTI_TOUCH_MAX_NUM，防止 touchIds 数组越界
+        const int total = node.data.macroMultiTouch.touchNodesCount;
+        const int count = qMin(total, MULTI_TOUCH_MAX_NUM);
+        if (total > MULTI_TOUCH_MAX_NUM) {
+            qWarning("macroMultiTouch: touchNodes=%d > MULTI_TOUCH_MAX_NUM=%d, truncated", total, MULTI_TOUCH_MAX_NUM);
+        }
+        st->count = count;
+        for (int i = 0; i < count; i++) {
+            int delay = node.data.macroMultiTouch.touchNodes[i].delay;
+            QPointF pos = node.data.macroMultiTouch.touchNodes[i].pos;
+            int slot = i;
+            // 用唯一伪 key 分配 touch id，避免与其它映射/宏冲突
+            // qint64 计算，防止大键码（>= 0x01000000）乘 1000 后 int 溢出
+            const qint64 pseudoKey = static_cast<qint64>(key) * 1000 + slot;
+            // 捕获状态指针 + 代数做身份校验：松开后快速再按（状态被替换/代数递增）时，
+            // 旧的 singleShot 不会误触发到新状态上
+            const int gen = st->generation;
+            MacroMultiTouchState *stPtr = st;
+            QTimer::singleShot(delay, this, [this, key, stPtr, gen, slot, pos, pseudoKey]() {
+                MacroMultiTouchState *s = m_macroMultiTouchStates.value(key, nullptr);
+                if (s != stPtr || s->generation != gen) return;  // 状态已删除或被新一轮按下替换
+                if (s->touchIds[slot] >= 0) return;  // 已落下或已取消
+                int id = attachTouchID(pseudoKey);
+                if (id < 0) {
+                    qWarning("macroMultiTouch: no free touch id, MULTI_TOUCH_MAX_NUM=%d", MULTI_TOUCH_MAX_NUM);
+                    return;
+                }
+                s->touchIds[slot] = id;
+                sendTouchDownEvent(id, pos);
+            });
+        }
+    } else if (QEvent::KeyRelease == from->type()) {
+        // 释放该 key 所有已落下的手指，并删除状态
+        MacroMultiTouchState *st = m_macroMultiTouchStates.value(key, nullptr);
+        if (st) {
+            const int bounded = qMin(st->count, MULTI_TOUCH_MAX_NUM);
+            for (int i = 0; i < bounded; i++) {
+                if (st->touchIds[i] >= 0) {
+                    sendTouchUpEvent(st->touchIds[i], QPointF(0, 0));
+                    m_multiTouchID[st->touchIds[i]] = 0;
+                    st->touchIds[i] = -1;
+                }
+            }
+            m_macroMultiTouchStates.remove(key);
+            delete st;
+        }
+        // 注意：未落下的（singleShot 还没触发的）在回调里检查 !s 会自动取消
+    }
+}
+
+// 按住循环点击宏：按下立即第1次点击 → delay → 第2次 → ... → 松开立即停
+// 每个触发键有独立的 MacroLoopClickState 和 timer，互不影响
+void InputConvertGame::processMacroLoopClick(const KeyMap::KeyMapNode &node, const QKeyEvent *from)
+{
+    int key = from->key();
+
+    if (QEvent::KeyPress == from->type()) {
+        // 若该 key 已在运行，先停止并复位（防止连按残留）
+        MacroLoopClickState *st = m_macroLoopClickStates.value(key, nullptr);
+        if (!st) {
+            st = new MacroLoopClickState();
+            st->timer = new QTimer(this);
+            st->timer->setSingleShot(false);  // 重复触发，实现循环
+            // 定时器回调只在状态创建时连接一次（状态删除时定时器随之销毁），
+            // 避免重复 KeyPress 造成重复连接、每 tick 多次触发
+            connect(st->timer, &QTimer::timeout, this, [this, key]() {
+                MacroLoopClickState *s = m_macroLoopClickStates.value(key, nullptr);
+                if (!s) return;  // 已被删除
+                // 瞬间点击：down + up 在同一回调内连续发送
+                if (s->touchId < 0) {
+                    s->touchId = attachTouchID(static_cast<qint64>(s->pressKey) * 1000);
+                    if (s->touchId < 0) {
+                        qWarning("macroLoopClick: no free touch id");
+                        return;
+                    }
+                }
+                sendTouchDownEvent(s->touchId, s->pos);
+                sendTouchUpEvent(s->touchId, s->pos);
+            });
+            m_macroLoopClickStates.insert(key, st);
+        }
+        // 停止旧定时器并抬起残留触点
+        st->timer->stop();
+        if (st->touchId >= 0) {
+            sendTouchUpEvent(st->touchId, st->pos);
+            m_multiTouchID[st->touchId] = 0;
+            st->touchId = -1;
+            st->touching = false;
+        }
+
+        st->pressKey = key;
+        st->pos = node.data.macroLoopClick.pos;
+        st->delay = node.data.macroLoopClick.delay;
+
+        // 立即触发第 1 次点击，然后按 delay 循环
+        // 触发第 1 次（与定时器回调逻辑一致：瞬间点击）
+        if (st->touchId < 0) {
+            st->touchId = attachTouchID(static_cast<qint64>(st->pressKey) * 1000);
+        }
+        if (st->touchId >= 0) {
+            sendTouchDownEvent(st->touchId, st->pos);
+            sendTouchUpEvent(st->touchId, st->pos);
+        }
+        st->timer->start(st->delay);
+    } else if (QEvent::KeyRelease == from->type()) {
+        // 松开立即停止该 key 的循环
+        MacroLoopClickState *st = m_macroLoopClickStates.value(key, nullptr);
+        if (st) {
+            st->timer->stop();
+            if (st->touchId >= 0) {
+                sendTouchUpEvent(st->touchId, st->pos);
+                m_multiTouchID[st->touchId] = 0;
+                st->touchId = -1;
+                st->touching = false;
+            }
+            m_macroLoopClickStates.remove(key);
+            delete st->timer;
+            delete st;
+        }
+    }
+}
